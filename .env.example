# Copy to .env (gitignored) before running `docker compose up`.
# Generate the secrets, don't reuse these lines:
#   openssl rand -base64 32   # MYSQL_ROOT_PASSWORD / DB_PASSWORD / API_ACCESS_KEY

NODE_ENV=production

MYSQL_ROOT_PASSWORD=
DB_USER=paint_app
DB_PASSWORD=
DB_NAME=paint_visualizer

# Shared infra guard for /api (min 16 chars, no placeholder values). The API
# fails closed when this is unset and NODE_ENV is not "development".
API_ACCESS_KEY=

# Comma-separated allowlist of browser origins permitted to call the API.
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000

# Hosted AI provider (see backend/.env.example for the full option list).
AI_PROVIDER=huggingface
HF_API_KEY=
HF_MODEL=
HF_API_URL=
CLIPDROP_API_KEY=
CLIPDROP_CLEANUP_URL=
