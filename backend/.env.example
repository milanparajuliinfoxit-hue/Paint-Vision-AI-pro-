# Server
PORT=4000
NODE_ENV=development
# Basic infra-level protection since there is no app-level auth (see requirements doc, Section 7).
# REQUIRED unless NODE_ENV=development: at least 16 chars and not a placeholder,
# otherwise every /api request is rejected with 503. Generate with:
#   openssl rand -base64 32
API_ACCESS_KEY=
# Comma-separated allowlist of browser origins allowed to call the API.
# Defaults to the local Vite dev origins when unset — never use "*" in production.
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=paint_visualizer_pro

# Local folder storage (see requirements doc, Section 6.3)
UPLOAD_ROOT=./uploads
MAX_UPLOAD_MB=25

# Hosted AI API (Path B) — provider-agnostic. The backend proxies a hosted
# model so the vendor key never reaches the browser. Select a provider with
# AI_PROVIDER; only the matching block below is used by
# src/services/aiProxy.service.js (dispatcher) + src/services/providers/.
AI_PROVIDER=huggingface

# --- Clipdrop (cleanup / inpainting) ----------------------------------------
# Requires a Clipdrop API key.
CLIPDROP_API_KEY=replace-with-real-key
CLIPDROP_CLEANUP_URL=https://clipdrop-api.co/cleanup/v1

# --- Hugging Face Inference Providers ------------------------------------------
# The legacy serverless endpoint (api-inference.huggingface.co) is DECOMMISSIONED.
# Calls now go to https://router.huggingface.co/<provider>/<provider-model-id>.
# The token stays backend-only (Authorization: Bearer) and never reaches the browser.
# NOTE: image models on partner providers are BILLED to the HF account — you need
# pre-paid credits or a PRO subscription ("You have depleted your monthly
# included credits", HTTP 402, otherwise).
HF_API_KEY=
# Verified working example: fal-ai FLUX.2 edit model (prompt + image_urls data URI).
HF_MODEL=fal-ai/fal-ai/flux-2/klein/9b/edit
HF_API_URL=https://router.huggingface.co/fal-ai/fal-ai/flux-2/klein/9b/edit
# Payload shape varies per provider/model:
#   json (default) POST a JSON body, see HF_JSON_SHAPE below
#   binary        POST raw image bytes (only if the endpoint accepts them)
#   multipart     send HF_IMAGE_FIELD + optional HF_MASK_FIELD as FormData
HF_INPUT_MODE=json
# JSON body shape:
#   image_urls (default) -> {"prompt": HF_PROMPT, "image_urls": ["data:image/png;base64,…"]}  (fal-ai style edit models)
#   generic             -> {"inputs": "<base64>", "parameters": {"prompt": HF_PROMPT}}        (generic HF image-to-image spec)
HF_JSON_SHAPE=image_urls
# Cleanup instruction sent to the model.
HF_PROMPT=Remove objects, debris, and unwanted elements from this house photo; keep the building unchanged; photorealistic
HF_IMAGE_FIELD=image_urls
HF_MASK_FIELD=mask_file
HF_IMAGE_CONTENT_TYPE=application/octet-stream
