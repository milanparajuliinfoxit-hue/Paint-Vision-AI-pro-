# Server
PORT=4000
NODE_ENV=development
# Basic infra-level protection since there is no app-level auth (see requirements doc, Section 7)
API_ACCESS_KEY=change-me-long-random-string
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword123
DB_NAME=paint_visualizer_pro

# Local folder storage (see requirements doc, Section 6.3)
UPLOAD_ROOT=./uploads
MAX_UPLOAD_MB=25

# Hosted AI API (Path B) — provider-agnostic. The backend proxies a hosted
# model so the vendor key never reaches the browser. Select a provider with
# AI_PROVIDER; only the matching block below is used by
# src/services/aiProxy.service.js (dispatcher) + src/services/providers/.
AI_PROVIDER=huggingface

# --- Clipdrop (cleanup / inpainting) ----------------------------------------
# Requires a Clipdrop API key.
CLIPDROP_API_KEY=replace-with-real-key
CLIPDROP_CLEANUP_URL=https://clipdrop-api.co/cleanup/v1

# --- Hugging Face Inference Providers ------------------------------------------
# The legacy serverless endpoint (api-inference.huggingface.co) is DECOMMISSIONED.
# Calls now go to https://router.huggingface.co/<provider>/<provider-model-id>.
# The token stays backend-only (Authorization: Bearer) and never reaches the browser.
# NOTE: image models on partner providers are BILLED to the HF account — you need
# pre-paid credits or a PRO subscription ("You have depleted your monthly
# included credits", HTTP 402, otherwise).
HF_API_KEY=
# Verified working example: fal-ai FLUX.2 edit model (prompt + image_urls data URI).
HF_MODEL=fal-ai/fal-ai/flux-2/klein/9b/edit
HF_API_URL=https://router.huggingface.co/fal-ai/fal-ai/flux-2/klein/9b/edit
# Payload shape varies per provider/model:
#   json (default) POST a JSON body, see HF_JSON_SHAPE below
#   binary        POST raw image bytes (only if the endpoint accepts them)
#   multipart     send HF_IMAGE_FIELD + optional HF_MASK_FIELD as FormData
HF_INPUT_MODE=json
# JSON body shape:
#   image_urls (default) -> {"prompt": HF_PROMPT, "image_urls": ["data:image/png;base64,…"]}  (fal-ai style edit models)
#   generic             -> {"inputs": "<base64>", "parameters": {"prompt": HF_PROMPT}}        (generic HF image-to-image spec)
HF_JSON_SHAPE=image_urls
# Cleanup instruction sent to the model.
HF_PROMPT=Remove objects, debris, and unwanted elements from this house photo; keep the building unchanged; photorealistic
HF_IMAGE_FIELD=image_urls
HF_MASK_FIELD=mask_file
HF_IMAGE_CONTENT_TYPE=application/octet-stream

# --- AI Understanding (house-understanding + paint recommendations) -------------
# House-understanding: two interchangeable providers are registered (see
# AI_HOSTED_ARCHITECTURE.md §9 for the full comparison) — pick one via
# AI_ANALYSIS_PROVIDER:
#   fal-vision       — SAM 3 on fal.ai (single model, one call per class).
#                       Current default while Replicate billing is unresolved.
#                       Requires FAL_API_KEY below.
#   replicate-vision — Grounding DINO + SAM2 on Replicate (two-stage).
#                       Requires REPLICATE_API_TOKEN below. Kept registered
#                       and selectable, not removed, for provider portability.
# Until AI_ANALYSIS_ENABLED=true AND the selected provider's key/token is
# set, analysis requests return a clear disabled-capability/missing-key
# error, never a fake/heuristic result. The prior local Grounding DINO +
# SAM2 service both of these replace (real remote alternatives checked at
# the time and found non-functional/unsuitable — hf-vision 400'd, no HF
# Inference Provider hosts grounding-dino/SAM/OWL-ViT, COCO/ADE20K are the
# wrong capability) was removed outright, not kept as a fallback.
#
# Recommendation provider defaults to `catalog` (rule-based color theory
# scored against catalog paints only — zero cost, zero dependency, never
# invented colors). `hf-scheme` is a real hosted-LLM alternative (verified
# live end-to-end) — the model proposes HSL *targets* only, never a catalog
# id directly, so every color is still guaranteed real by construction; see
# providers/hfSchemeProvider.js. Requires HF_API_KEY above.
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_PROVIDER=fal-vision
AI_RECOMMENDATION_ENABLED=true
AI_RECOMMENDATION_PROVIDER=catalog
# hf-scheme provider only:
AI_SCHEME_MODEL=meta-llama/Llama-3.1-8B-Instruct
AI_SCHEME_MODEL_PROVIDER=novita
# Downscale long edge of the photo before analysis (keeps the envelope small,
# also reused as the vision providers' upload size / cost control).
AI_ANALYSIS_MAX_DIM=640
# Number of schemes per request (clamped to 1..10, default 6).
AI_RECOMMENDATION_COUNT=6
# Optional CSV restriction to product lines present in the paints catalog.
AI_RECOMMENDATION_PRODUCT_LINES=

# --- fal.ai (fal-vision house-understanding provider) ----------------------
# https://fal.ai/dashboard/keys — required for fal-vision. Key format is
# "key_id:key_secret", sent as `Authorization: Key <FAL_API_KEY>` (fal's own
# scheme, not Bearer). Never sent to the frontend, never logged.
FAL_API_KEY=
# fal-ai/sam-3/image — schema confirmed from fal's own API reference (see
# AI_HOSTED_ARCHITECTURE.md §9). One unverified assumption remains: whether
# `image_url` accepts a data: URI directly (assumed, matching every other
# hosted model this app integrates) vs. requiring a separate upload step —
# flagged for the first live call to confirm.
FAL_SAM3_MODEL=fal-ai/sam-3/image
FAL_MAX_MASKS_PER_CLASS=3
# Poll loop for fal's async queue lifecycle (submit -> poll status -> fetch
# result). AI_VISION_TIMEOUT_MS above bounds the initial submit call.
AI_FAL_POLL_INTERVAL_MS=1500
AI_FAL_POLL_TIMEOUT_MS=45000

# --- Replicate (replicate-vision house-understanding provider) -------------
# https://replicate.com/account/api-tokens — required for replicate-vision.
# Never sent to the frontend, never logged (see httpClient.js's logging,
# which logs provider/model/status/latency only, never headers/body).
REPLICATE_API_TOKEN=
# Model slugs — schema for grounding-dino confirmed from source
# (replicate/cog-grounding-dino); sam-2's box-prompt field name is a
# best-effort guess pending a live test call (see AI_HOSTED_ARCHITECTURE.md §5).
REPLICATE_DINO_MODEL=adirik/grounding-dino
REPLICATE_SAM_MODEL=meta/sam-2
REPLICATE_SAM_BOX_FIELD=input_boxes
# Poll loop for Replicate's async prediction lifecycle (create -> poll GET
# until succeeded/failed/canceled). AI_VISION_TIMEOUT_MS above bounds the
# initial create call.
AI_REPLICATE_POLL_INTERVAL_MS=1500
AI_REPLICATE_POLL_TIMEOUT_MS=45000
