{
  "name": "paint-visualizer-backend",
  "version": "1.0.0",
  "description": "CRUD + storage backend for the Paint Dealer Visualizer. No image/AI processing happens here — it stores catalog data, project/job metadata, and proxies hosted AI API calls.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/scripts/runSchema.js",
    "reconcile": "node src/scripts/reconcileUploads.js",
    "smoke:vision": "node src/scripts/smokeVisionAssembly.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jimp": "^0.22.12",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
