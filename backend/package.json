{
  "name": "paint-visualizer-backend",
  "version": "1.0.0",
  "description": "CRUD + storage backend for the Paint Dealer Visualizer. No image/AI processing happens here — it stores catalog data, project/job metadata, and proxies hosted AI API calls.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/scripts/runSchema.js",
    "reconcile": "node src/scripts/reconcileUploads.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mysql2": "^3.10.0",
    "multer": "^2.0.2",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
